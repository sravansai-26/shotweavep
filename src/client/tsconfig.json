{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "moduleResolution": "Node",          // ✅ Safe and supported
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "ignoreDeprecations": "6.0"          // ✅ Prevent future deprecation errors
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
